# =============================================================================
# RASTRO — variáveis de ambiente
# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
# Prioridade das configurações: Banco (tela Integração) > .env > valor padrão.
# =============================================================================

# --- Banco de dados (obrigatório) --------------------------------------------
# Banco exclusivo do RASTRO. Não use o banco de outro projeto da VPS.
DATABASE_URL=postgresql://rastro:TROQUE_A_SENHA@127.0.0.1:5432/rastro_db

# --- Aplicação ----------------------------------------------------------------
# Porta livre na VPS (confira as portas dos outros projetos antes de escolher)
PORT=
# Endereço público com https (usado nos links dos e-mails). Domínio planejado: A definir.
APP_URL=
NODE_ENV=production

# Chave de criptografia dos segredos (AES-256-GCM): 32 bytes em base64.
# Gere com:  openssl rand -base64 32
# Guarde uma cópia em local seguro: sem ela, os segredos salvos pela tela não podem ser lidos.
SETTINGS_ENCRYPTION_KEY=

# --- Acessos -----------------------------------------------------------------
# E-mails (separados por vírgula) que viram perfil Desenvolvedor (setor TI)
DEVELOPER_EMAILS=
# Administrador inicial: usado só no primeiro acesso para cadastrar a equipe (troca de senha obrigatória)
ADMIN_EMAIL=
# Mínimo de 10 caracteres, com letras e números
ADMIN_INITIAL_PASSWORD=

# --- Sessão e bloqueio -------------------------------------------------------
SESSION_TTL_HOURS=8
LOCK_IDLE_MINUTES=10
PIN_MAX_ATTEMPTS=5

# --- E-mail (SMTP) ------------------------------------------------------------
# Também pode ser configurado na tela Integração (a senha fica criptografada no banco).
# Enquanto o e-mail não for configurado E testado, só o desenvolvedor e o administrador
# inicial entram (sem 2FA). Depois do teste, o código por e-mail vale para todos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Mapas ------------------------------------------------------------------
# Pasta com o arquivo do mapa de fundo (.pmtiles). Padrão: ./basemap
BASEMAP_DIR=
# Nome do arquivo .pmtiles da região de operação (ver docs/mapa-de-fundo.md)
BASEMAP_PMTILES_FILE=
# Serviço de ruas do OpenStreetMap (Overpass). Padrão: https://overpass-api.de/api/interpreter
OVERPASS_URL=
# Busca de endereços (Nominatim). Padrão: https://nominatim.openstreetmap.org
NOMINATIM_URL=

# --- Opcionais ----------------------------------------------------------------
# Pasta para arquivos gerados pelo sistema (artefatos substituídos pela tela). Padrão: ./storage
STORAGE_DIR=
# Limite de tentativas por IP nas rotas de login, código e senha (a cada 15 minutos). Padrão: 10
AUTH_RATE_LIMIT=
